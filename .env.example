# ==============================================================
# TIDESK - UNIVERSIDAD NACIONAL DE CAÑETE
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================

# Entorno
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost   000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:1234@localhost:5432/tidesk_db?schema=public"

# Seguridad y Autenticación JWT
JWT_SECRET=tidesk_undc_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Almacenamiento de Archivos (Local / S3)
STORAGE_DRIVER=local
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_MB=15

# Notificaciones y Correo Electrónico (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte@undc.edu.pe
SMTP_PASS=tu_password_o_app_password
SMTP_FROM="TIDESK - Soporte UNDC <no-reply@undc.edu.pe>"