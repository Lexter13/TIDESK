      <bpmndi:BPMNEdge id="Flow_22_di" bpmnElement="Flow_22"><di:waypoint x="3140" y="725"/><di:waypoint x="3170" y="725"/><di:waypoint x="3170" y="185"/><di:waypoint x="3190" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_23_di" bpmnElement="Flow_23"><di:waypoint x="3360" y="185"/><di:waypoint x="3410" y="188"/></bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
