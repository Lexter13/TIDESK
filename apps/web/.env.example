# ==============================================================
# TIDESK WEB (Next.js) - UNIVERSIDAD NACIONAL DE CAÑETE
# Plantilla de variables de entorno
#
# Uso: copiar este archivo a apps/web/.env.local
# El archivo .env.local real NO se versiona (ver .gitignore).
# ==============================================================

# URL base de la API (NestJS), incluyendo el prefijo /api/v1
# (En Docker/Dokploy se pasa como Build Time Argument, no como variable de entorno:
#  Next.js la incrusta en el JavaScript del navegador al compilar. Ver apps/web/Dockerfile.)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
