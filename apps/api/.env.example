# ==============================================================
# TIDESK API (NestJS) - UNIVERSIDAD NACIONAL DE CAÑETE
# Plantilla de variables de entorno
#
# Uso: copiar este archivo a apps/api/.env y completar los valores.
# El archivo .env real NO se versiona (ver .gitignore).
# ==============================================================

# Entorno
NODE_ENV=development
PORT=4000
# URL del frontend (se agrega a la lista de CORS)
FRONTEND_URL=http://localhost:3000

# Base de Datos PostgreSQL
# La contraseña debe coincidir con POSTGRES_PASSWORD de docker-compose.yml (por defecto: 1234)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/tidesk_db?schema=public"

# Seguridad y Autenticación JWT
# Usar un secreto único y aleatorio. Para generarlo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Almacenamiento de Archivos (Local / S3)
# Reservadas: el código todavía no lee estas variables
STORAGE_DRIVER=local
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_MB=15

# Notificaciones y Correo Electrónico (SMTP)
# El transporte SMTP se crea cuando SMTP_HOST y SMTP_USER tienen valor.
# SMTP_ENABLED y SMTP_SECURE todavía no se leen en el código (el modo seguro se deduce del puerto 465).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte@undc.edu.pe
SMTP_PASS=tu_password_o_app_password
SMTP_FROM="TIDESK - Soporte UNDC <no-reply@undc.edu.pe>"
